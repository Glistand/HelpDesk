COMPOSE_PROJECT_NAME=helpdesk

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_PORT=5432

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_CLIENT_PORT=4222
NATS_MONITOR_URL=http://localhost:8222
NATS_MONITOR_PORT=8222

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_PORT=7700
MEILI_MASTER_KEY=helpdesk-dev-key

# Auth / JWT
JWT_SECRET=helpdesk-dev-secret-change-me
AUTH_GRPC_PORT=50051

# Ticket service
TICKET_GRPC_PORT=50052
TICKET_DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/ticket?sslmode=disable

# Project profile (seeded to the database only on first run)
PROJECT_GRPC_PORT=50059
PROJECT_DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/project?sslmode=disable
PROJECT_NAME=SalonPro
PROJECT_DESCRIPTION=Платформа для управления салонами красоты: запись, оплата и рабочие места администраторов и мастеров.
PROJECT_DOMAIN=beauty-salon-management
PROJECT_WEBSITE_URL=
PROJECT_SUPPORT_EMAIL=
PROJECT_SUPPORT_PHONE=
PROJECT_TIMEZONE=Europe/Moscow
PROJECT_BOT_INSTRUCTIONS=Помогай клиентам записаться на услуги салона, узнать стоимость, изменить или отменить запись. Если уверенного ответа нет, передай обращение менеджеру.
PROJECT_AUTO_CREATE_TICKET=true

# API Gateway
GATEWAY_HTTP_PORT=8080

# Support widget / OpenRouter bot (conversation-service)
# Never commit a real key. Rotate if it was pasted in chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WIDGET_SITE_KEY=demo-site
CONVERSATION_GRPC_PORT=50058

# Next.js UI (apps/web)
WEB_PORT=3001
GATEWAY_URL=http://localhost:8080

# Observability (Phase 6)
# Host-side OTLP (when running services outside Compose).
# Inside Compose services always use http://jaeger:4318.
JAEGER_UI_PORT=16686
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# GitHub Container Registry (optional; used by make up-ghcr)
GHCR_OWNER=glistand
IMAGE_TAG=latest
