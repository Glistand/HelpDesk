{
  "name": "@helpdesk/widget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --global-name=HelpDeskWidget --outfile=dist/widget.js && cp dist/widget.js ../web/public/widget.js",
