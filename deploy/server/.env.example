COMPOSE_PROJECT_NAME=helpdesk

# --- Images (GitHub Container Registry) ---
GHCR_OWNER=glistand
IMAGE_TAG=latest
PULL_POLICY=always

# --- Published host ports (only these are exposed) ---
WEB_PORT=80
GATEWAY_PORT=8080

# --- Secrets (CHANGE before going beyond a smoke test) ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_ENV=production

# --- SLA (server defaults; shorter values only for chaos/demo) ---
SLA_FIRST_RESPONSE=5m
SLA_RESOLVE=30m
SLA_WARN_RATIO=0.5
SLA_POLL_INTERVAL=1s
OUTBOX_POLL_INTERVAL=500ms
ESCALATION_L2_ASSIGNEE=a-3
