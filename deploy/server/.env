COMPOSE_PROJECT_NAME=helpdesk

# Images
GHCR_OWNER=glistand
IMAGE_TAG=latest
PULL_POLICY=always

# Only these ports are published on the host
WEB_PORT=80
GATEWAY_PORT=8080

# Secrets — change before real use
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_ENV=production

# SLA
SLA_FIRST_RESPONSE=5m
SLA_RESOLVE=30m
SLA_WARN_RATIO=0.5
SLA_POLL_INTERVAL=1s
OUTBOX_POLL_INTERVAL=500ms
ESCALATION_L2_ASSIGNEE=a-3

# Support widget bot (OpenRouter). Leave empty for polite fallback replies.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WIDGET_SITE_KEY=demo-site
